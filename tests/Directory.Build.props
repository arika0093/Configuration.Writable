<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatAllWarningsAsErrors>true</MSBuildTreatAllWarningsAsErrors>
    <RestoreTreatWarningsAsErrors>true</RestoreTreatWarningsAsErrors>
    <TargetFrameworks Condition="'$(TFMS)' != ''">$(TFMS)</TargetFrameworks>
    <TargetFrameworks Condition="'$(TFMS)' == ''">net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <PublishAot Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' != 'net6.0' and '$(TargetFramework)' != 'net48'">true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
    <SonarQubeExclude>true</SonarQubeExclude>
    <NoWarn>$(NoWarn);CWWR001;CWWR010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Shouldly" Version="4.*" />
    <PackageReference Include="TUnit" Version="1.66.27" />
    <PackageReference Include="Microsoft.Testing.Extensions.Retry" Version="2.4.0" />
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- PolySharp provides System.Index/System.Range polyfills for net48 only. -->
    <PackageReference
      Include="PolySharp"
      Version="1.*"
      Condition="'$(TargetFramework)' == 'net48'"
    />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)AssemblyInfo.cs" Link="AssemblyInfo.cs" />
    <Using Include="TUnit" />
    <Using Include="Shouldly" />
    <Using Include="Configuration.Writable.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Configuration.Writable.Testing\Configuration.Writable.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Configuration.Writable.Generator\Configuration.Writable.Generator.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
</Project>
